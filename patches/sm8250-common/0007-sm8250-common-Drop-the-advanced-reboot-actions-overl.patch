From ec846c6031d4a96abe6bb28b6fc4969e390fcb6f Mon Sep 17 00:00:00 2001
From: rivena port <port@localhost>
Date: Mon, 26 Oct 2026 08:23:30 +0800
Subject: [PATCH 7/8] sm8250-common: Drop the advanced reboot actions overlay
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

LOS 24 的 lineage-sdk 不再提供 config_restartActionsList，
RRO 引用不存在的资源会编译失败。
---
 .../lineage-sdk/lineage/res/res/values/config.xml         | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml b/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml
index 9213924..bba6375 100644
--- a/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml
+++ b/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml
@@ -12,12 +12,4 @@
 
     <!-- Whether device has screen with higher aspect ratio -->
     <bool name="config_haveHigherAspectRatioScreen">true</bool>
-
-    <!-- Defines the actions shown in advanced reboot submenu -->
-    <string-array name="config_restartActionsList">
-        <item>restart</item>
-        <item>restart_recovery</item>
-        <item>restart_bootloader</item>
-        <item>restart_fastboot</item>
-    </string-array>
 </resources>
-- 
2.43.0

